# ─── 音声フィードバック モード ─────────────────────────────────────────
# "direct" : アプリから OpenAI TTS API を直接呼ぶ（開発・検証用）
# "proxy"  : 自前バックエンド経由で呼ぶ（本番推奨。APIキーをサーバー側で管理）
EXPO_PUBLIC_VOICE_MODE=direct

# ─── Direct モード（開発用） ────────────────────────────────────────────
# ⚠️  EXPO_PUBLIC_ 変数はビルド時にバンドルされます。
#    本番リリースでは必ず proxy モードを使い、このキーは空にしてください。
EXPO_PUBLIC_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI TTS で使う声の種類
# 選択肢: alloy / echo / fable / onyx / nova / shimmer
EXPO_PUBLIC_OPENAI_VOICE=nova

# ─── Proxy モード（本番用） ─────────────────────────────────────────────
# 自前バックエンドが音声バイナリ(audio/mpeg)を返す POST エンドポイント
# リクエストボディ: { "text": string }
EXPO_PUBLIC_VOICE_API_URL=https://your-backend.example.com/api/voice/tts
